{
  "name": "sop-writer",
  "productName": "SOP Writer",
  "version": "0.2.45",
  "description": "Generate parameterized Standard Operating Procedures with an LLM.",
  "author": "bburge14 <bradey.burge@gmail.com>",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "serve": "node scripts/supervisor.mjs",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "app:install": "bash scripts/install.sh",
    "app:update": "bash scripts/update.sh",
    "app:uninstall": "bash scripts/uninstall.sh",
    "prepare:standalone": "node scripts/prepare-standalone.mjs",
    "electron:start": "npm run build && npm run prepare:standalone && electron .",
    "dist": "npm run build && npm run prepare:standalone && electron-builder --publish never",
    "dist:linux": "npm run dist -- --linux",
    "dist:win": "npm run dist -- --win",
    "dist:mac": "npm run dist -- --mac"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.9",
    "@lezer/common": "^1.5.2",
    "@lezer/highlight": "^1.2.3",
    "@lezer/markdown": "^1.7.2",
    "docx": "^9.7.1",
    "electron-updater": "^6.8.9",
    "lucide-react": "^0.446.0",
    "mammoth": "^1.12.1",
    "next": "^16.3.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "remark-gfm": "^4.0.0",
    "remark-parse": "^11.0.0",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/turndown": "^5.0.6",
    "autoprefixer": "^10.4.20",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.5.4"
  },
  "build": {
    "appId": "com.bburge14.sopwriter",
    "productName": "SOP Writer",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "package.json",
      "node_modules/**/*",
      "!node_modules/next/**/*",
      "!node_modules/@next/**/*",
      "!node_modules/react/**/*",
      "!node_modules/react-dom/**/*",
      "!node_modules/react-markdown/**/*",
      "!node_modules/remark-gfm/**/*",
      "!node_modules/lucide-react/**/*",
      "!node_modules/sharp/**/*",
      "!node_modules/@img/**/*",
      "!node_modules/styled-jsx/**/*",
      "!node_modules/scheduler/**/*",
      "!node_modules/client-only/**/*",
      "!node_modules/@swc/**/*",
      "!node_modules/tailwindcss/**/*",
      "!node_modules/postcss/**/*",
      "!node_modules/autoprefixer/**/*",
      "!node_modules/typescript/**/*",
      "!node_modules/electron/**/*",
      "!node_modules/electron-builder/**/*",
      "!node_modules/.bin/**/*",
      "!app/**",
      "!components/**",
      "!lib/**",
      "!types/**",
      "!scripts/**",
      "!.next/**",
      "!*.md",
      "!.env*"
    ],
    "extraResources": [
      {
        "from": ".next/pkg-src",
        "to": ".",
        "filter": [
          "**/*",
          "app-server/node_modules/**/*"
        ]
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "bburge14",
        "repo": "SOP"
      }
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "icon": "build/icon.png"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon.png"
    }
  }
}
