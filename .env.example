# Which provider the adapter factory (lib/llm/index.ts) should instantiate.
# One of: openai | gemini | ollama
LLM_PROVIDER=gemini

# --- OpenAI ---
# See lib/llm/modelOptions.ts for the current recommended/alternative model
# IDs — provider model names change over time (e.g. gemini-2.0-flash below
# was retired by Google); that file is the single source of truth, this is
# just its default mirrored for self-hosted setups using .env.local instead
# of the desktop app's Settings dropdown.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra

# --- Google Gemini ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# --- Ollama (local, no API key) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# --- Self-update (app/api/update, see README "Self-updating") ---
# Optional shared secret required in the X-Update-Token header to trigger
# a pull+rebuild+restart from the GUI. Leave unset only if this instance is
# not reachable by anyone you don't trust (e.g. bound to localhost only).
UPDATE_TOKEN=
